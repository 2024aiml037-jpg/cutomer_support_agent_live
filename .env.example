# ── LLM ──────────────────────────────────────────────────────────────────────
# Groq (required) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.2

# Google Gemini (used for embeddings by default)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# OpenAI (optional fallback)
OPENAI_API_KEY=

# ── Embeddings ────────────────────────────────────────────────────────────────
# Set to true to use local sentence-transformers instead of Gemini embeddings.
# Requires sentence-transformers and torch to be installed.
ENABLE_LOCAL_EMBEDDINGS=false

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Paths (relative to project root) ─────────────────────────────────────────
DATA_DIR=data
DB_PATH=data/support.db
CHROMA_RAG_DIR=data/chroma_rag
CHROMA_MEM0_DIR=data/chroma_mem0
KNOWLEDGE_BASE_DIR=knowledge_base

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4

# ── Memory ────────────────────────────────────────────────────────────────────
MEM0_TOP_K=5

# ── Dashboard ─────────────────────────────────────────────────────────────────
# URL the Streamlit dashboard uses to reach the API.
# In Docker Compose this is overridden to http://api:8000.
API_BASE_URL=http://localhost:8000
